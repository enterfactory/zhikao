# Copy to .env.ecs.local at repository root; fill in your own infrastructure.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=zhikao
ZHIKAO_DB_SCHEMA=zhikao
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
ZHIKAO_REDIS_NAMESPACE=zhikao:local:
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
ZHIKAO_VECTOR_COLLECTION=zhikao_knowledge_v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=your-chat-model
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIM=1024
ZHIKAO_BOOTSTRAP_ADMIN=owner
ZHIKAO_BOOTSTRAP_PASSWORD=
ZHIKAO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
